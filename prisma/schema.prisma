// OPERATIONAL — METRICS / KPIs
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only KPI snapshot per company. Query ORDER BY createdAt DESC LIMIT 1 for current value.
model Metric {
  id        String  @id @default(cuid())
  companyId String
  label     String
  value     String
  change    String?
  period    String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, label])
  @@index([companyId, period])
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL — WORKER AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

enum WorkerRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL // completed with some item-level errors
}

/// One execution of a worker — written at start, updated at end.
model WorkerRun {
  id        String          @id @default(cuid())
  worker    String // e.g. "segment-sync", "card-score"
  trigger   String // "cron" | "manual" | "event:<name>"
  status    WorkerRunStatus @default(RUNNING)
  companyId String? // null = ran across all companies

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  itemsTotal     Int?
  itemsProcessed Int?
  itemsFailed    Int?

  meta  Json? // arbitrary input context (filters, ids, etc.)
  error String? // top-level error message if status=FAILED

  logs WorkerLog[]

  @@index([worker])
  @@index([worker, startedAt])
  @@index([status])
  @@index([companyId])
}

/// Fine-grained log line attached to a WorkerRun.
model WorkerLog {
  id      String  @id @default(cuid())
  runId   String
  level   String // "info" | "warn" | "error"
  message String
  itemId  String? // e.g. customerId, cardId — makes log searchable by entity
  detail  Json? // extra structured data

  createdAt DateTime @default(now())

  run WorkerRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, level])
  @@index([itemId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MESSAGING QUEUE — INBOX / OUTBOX
// ─────────────────────────────────────────────────────────────────────────────

/// Fila de entrada: cada mensagem recebida do WhatsApp é enfileirada aqui pelo webhook.
/// O worker inbound-processor processa de forma assíncrona com retry e auditoria.
model InboundMessage {
  id            String        @id @default(cuid())
  companyId     String
  instanceId    String // nome da instância Evolution
  waMessageId   String // key.id do payload Evolution — garante idempotência
  senderPhone   String
  messageType   String // "conversation" | "imageMessage" | "audioMessage" | etc.
  payload       Json // payload bruto do EvoMessage inteiro
  status        InboundStatus @default(PENDING)
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @default(now())
  processedAt   DateTime?
  error         String?
  receivedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@unique([instanceId, waMessageId])
  @@index([status, nextAttemptAt])
  @@index([companyId])
}

/// Fila de saída: cada mensagem a enviar para o cliente é enfileirada aqui.
/// O worker outbound-sender lê com FOR UPDATE SKIP LOCKED e envia via Evolution API.
model OutboundMessage {
  id              String         @id @default(cuid())
  companyId       String
  conversationId  String
  instanceId      String
  recipientPhone  String
  messageType     String         @default("text")
  body            String?        @db.Text
  payload         Json?
  status          OutboundStatus @default(QUEUED)
  priority        Int            @default(5)
  attempts        Int            @default(0)
  maxAttempts     Int            @default(5)
  nextAttemptAt   DateTime       @default(now())
  clientRequestId String?
  waMessageId     String?
  error           String?
  createdByUserId String?
  sentAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([clientRequestId])
  @@index([status, nextAttemptAt, priority])
  @@index([conversationId])
  @@index([companyId])
}

