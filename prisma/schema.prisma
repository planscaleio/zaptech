// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL — KANBAN BOARDS
// ─────────────────────────────────────────────────────────────────────────────

model KanbanBoard {
  id        String @id @default(cuid())
  companyId String
  name      String
  sortOrder Int    @default(0)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  columns KanbanColumn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model KanbanColumn {
  id          String  @id @default(cuid())
  boardId     String
  name        String
  sortOrder   Int     @default(0)
  color       String? @default("#e5e7eb")
  probability Int? // 0-100 — probabilidade de fechamento nesta etapa
  slaHours    Int? // horas máximas que um card pode ficar nesta etapa

  board KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards KanbanCard[]

  @@index([boardId])
}

model KanbanCard {
  id              String           @id @default(cuid())
  columnId        String
  customerId      String?
  assignedUserId  String? // responsável pelo negócio (diferente do dono do cliente)
  initials        String?
  name            String
  description     String?
  score           Int?
  scoreBreakdown  Json?
  priority        KanbanPriority   @default(MEDIA)
  dots            Int              @default(0)
  value           Decimal?         @db.Decimal(14, 2)
  expectedCloseAt DateTime?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  closeType       KanbanCloseType? // GANHO | PERDIDO | CANCELADO
  closeReason     String? // motivo de perda ou ganho

  column       KanbanColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id])
  assignedUser User?            @relation("KanbanCardAssignee", fields: [assignedUserId], references: [id])
  activities   KanbanActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId])
  @@index([customerId])
  @@index([assignedUserId])
}

enum KanbanCloseType {
  GANHO
  PERDIDO
  CANCELADO
}

enum KanbanActivityType {
  NOTA
  LIGACAO
  EMAIL
  REUNIAO
  TAREFA
  WHATSAPP
}

model KanbanActivity {
  id         String             @id @default(cuid())
  cardId     String
  type       KanbanActivityType @default(NOTA)
  title      String?
  content    String
  doneAt     DateTime?
  authorName String             @default("Sistema")

  card KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cardId])
}

