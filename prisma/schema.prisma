// ─── Prisma config ────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum CompanyStatus {
  ATIVA
  TRIAL
  INADIMPLENTE
  SUSPENSA
}

enum PlanBilling {
  MENSAL
  NEGOCIADO
}

enum UserRole {
  OWNER
  ADMIN
  GESTOR
  ATENDENTE
}

enum UserStatus {
  ATIVO
  TRIAL
  BLOQUEADO
}

enum AdminUserRole {
  SUPER_ADMIN
  FINANCEIRO
}

enum InvoiceStatus {
  PAGO
  VENCIDO
  TRIAL
  PENDENTE
  CANCELADO
}

enum InvoicePaymentMethod {
  BOLETO
  CARTAO
  PIX
  NEGOCIADO
}

enum ConversationStatus {
  ALTA_INTENCAO
  AGUARDANDO
  EM_ANALISE
  RESOLVIDO
  ENCERRADO
  ARQUIVADO
  PARA_EXCLUIR
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  SITE
  EMAIL
  TELEFONE
  WEBHOOK
}

enum MessageRole {
  CLIENTE
  ATENDENTE
  AGENTE_IA
  SISTEMA
}

enum MessageAttachmentType {
  IMAGE
  AUDIO
  DOCUMENT
  VIDEO
}

enum AgentStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum CustomerStatus {
  QUENTE
  NUTRICAO
  EM_ANALISE
  CLIENTE
  INATIVO
  PERDIDO
}

enum CustomerStage {
  PROSPECCAO
  QUALIFICACAO
  DEMONSTRACAO
  PROPOSTA
  NEGOCIACAO
  FECHADO
  POS_VENDA
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  SITE
  CAMPANHA_CRM
  WEBHOOK
  EMAIL
  INDICACAO
  ORGANICO
  OUTRO
}

enum WorkflowStatus {
  ATIVO
  PAUSADO
  RASCUNHO
  ARQUIVADO
}

enum KnowledgeArticleStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum BroadcastStatus {
  AGENDADA
  EM_ENVIO
  CONCLUIDA
  RASCUNHO
  CANCELADA
}

enum CampaignType {
  AQUISICAO
  RETENCAO
  ABM
  REATIVACAO
  UPSELL
}

enum CampaignStatus {
  ATIVA
  PLANEJADA
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum DynamicQrStatus {
  ATIVO
  PAUSADO
  ARQUIVADO
}

enum ConnectorType {
  CANAL
  CRM
  ENTRADA
  AGENDA
  PAGAMENTO
  OUTRO
}

enum ConnectorStatus {
  CONECTADO
  ATIVO
  REVISAR
  DESCONECTADO
  ERRO
}

enum EmailAccountStatus {
  CONECTADO
  DESCONECTADO
  REVISAR
  ERRO
}

enum FlowNodeType {
  ASSISTENTE_IA
  ENVIAR_MENSAGEM
  CONDICAO
  ESPERA
  WEBHOOK
  TRANSFERIR_AGENTE
  FINALIZAR
}

enum RiskLevel {
  BAIXO
  MEDIO
  ALTO
  CRITICO
}

enum Sentiment {
  POSITIVO
  NEUTRO
  NEGATIVO
}

enum ChatSentiment {
  POSITIVO
  NEUTRO
  NEGATIVO
}

enum KanbanPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum ProductStatus {
  ATIVO
  CANCELADO
  CONCLUIDO
  PENDENTE
}

enum CatalogItemStatus {
  ATIVO
  INATIVO
}

enum QuoteStatus {
  RASCUNHO
  ENVIADO
  ACEITO
  RECUSADO
  EXPIRADO
  CANCELADO
}

enum QuoteDiscountType {
  VALOR
  PERCENTUAL
}

enum QuoteEventType {
  CRIADO
  ATUALIZADO
  ENVIADO
  ACEITO
  RECUSADO
  EXPIRADO
  CANCELADO
}

enum InboundStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum OutboundStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum RuleActionType {
  TEAM
  SPECIFIC_USER
  EXISTING_OWNER
  QUEUE
}

enum RuleStrategy {
  ROUND_ROBIN
  LOWEST_LOAD
  EXISTING_OWNER
  MANUAL
}

enum RuleFallback {
  QUEUE
  NEXT_RULE
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM-LEVEL (ADMIN) MODELS
// ─────────────────────────────────────────────────────────────────────────────

/// Subscription plan — null limits mean unlimited (Enterprise)
model Plan {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  color       String      @default("gray")
  price       Decimal     @db.Decimal(10, 2)
  billing     PlanBilling @default(MENSAL)
  highlight   Boolean     @default(false)
  description String?
  isActive    Boolean     @default(true)

  maxUsers  Int?
  maxChats  Int?
  maxAgents Int?
  maxBoards Int?

  features  PlanFeature[]
  extras    PlanExtra[]
  companies Company[]
  invoices  Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// Human-readable feature rows per plan (e.g. "Transmissões — Ilimitadas — included")
model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  label     String
  value     String  @default("")
  included  Boolean @default(true)
  sortOrder Int     @default(0)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

/// Overage pricing rows per plan.
/// unitPriceCents: machine-readable price in BRL centavos (0 = included/negotiated).
/// unitType: "user" | "1000_chats" | "agent" | "custom"
model PlanExtra {
  id             String @id @default(cuid())
  planId         String
  label          String
  price          String
  unitPriceCents Int    @default(0)
  unitType       String @default("custom")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

/// Tenant company
model Company {
  id     String        @id @default(cuid())
  name   String
  slug   String        @unique
  status CompanyStatus @default(TRIAL)
  planId String

  ownerName String?
  email     String?
  phone     String?
  cnpj      String?
  city      String?

  transferMessageUser String?   // ex: "Você será atendido por {nome}."
  transferMessageTeam String?   // ex: "Você foi transferido para nossa equipe de {nome}."
  maxWaitMinutes     Int?       @default(30)  // tempo máx. de espera do cliente em minutos

  mrr         Decimal   @default(0) @db.Decimal(10, 2)
  nextBilling DateTime?
  trialEndsAt DateTime?

  // Denormalised counters for admin dashboard speed
  currentUsers  Int @default(0)
  currentChats  Int @default(0)
  currentAgents Int @default(0)

  plan Plan @relation(fields: [planId], references: [id])

  users             User[]
  agents            Agent[]
  conversations     Conversation[]
  customers         Customer[]
  salesTeams        SalesTeam[]
  distributionRules DistributionRule[]
  kanbanBoards      KanbanBoard[]
  workflows         Workflow[]
  knowledgeArticles KnowledgeArticle[]
  segments          Segment[]
  broadcasts        Broadcast[]
  campaigns         Campaign[]
  productCategories ProductCategory[]
  catalogProducts   CatalogProduct[]
  quotes            Quote[]
  whatsAppRouting   CompanyWhatsAppRouting?
  dynamicQrLinks    DynamicQrLink[]
  dynamicQrClicks   DynamicQrClick[]
  connectors        Connector[]
  emailAccounts     EmailAccount[]
  metrics           Metric[]
  aiAudits          AIAudit[]
  invoices          Invoice[]
  tags              Tag[]
  supportTickets    SupportTicket[]
  businessAccounts  BusinessAccount[]
  messageAttachments MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@index([slug])
}

/// Per-company user
model User {
  id           String     @id @default(cuid())
  companyId    String
  name         String
  email        String
  role         UserRole   @default(ATENDENTE)
  status       UserStatus @default(ATIVO)
  lastSeen     DateTime?
  avatarUrl    String?
  passwordHash String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownedConversations  Conversation[]      @relation("ConversationAttendant")
  ownedCustomers      Customer[]          @relation("CustomerOwner")
  managedTeams        SalesTeam[]         @relation("TeamManager")
  teamMemberships     SalesTeamMember[]
  attendedCustomers   CustomerAttendant[]
  targetedByRules     DistributionRule[]  @relation("RuleTargetUser")
  assignedKanbanCards KanbanCard[]        @relation("KanbanCardAssignee")
  authLogs            AuthLog[]
  sessions            Session[]
  knowledgeArticles   KnowledgeArticle[] @relation("KnowledgeArticleAuthor")
  knowledgeArticleVersions KnowledgeArticleVersion[] @relation("KnowledgeArticleVersionAuthor")
  generatedQuotes     Quote[]     @relation("QuoteGeneratedBy")
  quoteEvents         QuoteEvent[] @relation("QuoteEventAuthor")
  auditedAuditRecords AIAudit[]   @relation("AIAuditAttendant")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, companyId])
  @@index([companyId])
  @@index([email])
  @@index([companyId, role])
}

/// Platform-level admin (cross-company, accesses Admin panel)
model AdminUser {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  role         AdminUserRole @default(FINANCEIRO)
  passwordHash String?
  lastSeen     DateTime?

  authLogs AuthLog[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuthLogResult {
  SUCCESS
  WRONG_PASSWORD
  USER_NOT_FOUND
  BLOCKED
}

enum AuthActorType {
  USER // User scoped a company
  ADMIN_USER // Platform admin
}

/// Audit log de todas as tentativas de login
model AuthLog {
  id          String         @id @default(cuid())
  email       String
  result      AuthLogResult
  actorType   AuthActorType?
  userId      String?
  adminUserId String?
  ip          String?
  userAgent   String?
  companyId   String?

  user      User?      @relation(fields: [userId], references: [id])
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@index([adminUserId])
  @@index([createdAt])
  @@index([result])
}

/// JWT session token válido (para invalidação via logout)
model Session {
  id          String   @id @default(cuid())
  userId      String?
  adminUserId String?
  token       String   @unique
  expiresAt   DateTime
  ip          String?
  userAgent   String?

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([adminUserId])
  @@index([expiresAt])
}

/// Singleton platform configuration (one row)
model PlatformConfig {
  id           String  @id @default(cuid())
  name         String  @default("ZapVendas")
  domain       String  @default("app.zapvendas.com.br")
  supportEmail String?
  timezone     String  @default("America/Sao_Paulo")
  gateway      String  @default("Stripe")
  currency     String  @default("BRL")
  trialDays    Int     @default(14)

  trialWarnDays      Int @default(3)
  invoiceOverdueDays Int @default(3)
  chatUsageThreshold Int @default(90)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Monthly billing invoice
model Invoice {
  id        String                @id @default(cuid())
  companyId String
  planId    String
  status    InvoiceStatus         @default(PENDENTE)
  method    InvoicePaymentMethod?
  amount    Decimal               @db.Decimal(10, 2)
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      Plan              @relation(fields: [planId], references: [id])
  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
}

/// Line items for base subscription + overages
model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL — CONVERSATIONS & MESSAGING
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id          String  @id @default(cuid())
  companyId   String
  customerId  String?
  agentId     String?
  attendantId String?
  teamId       String?
  emailAccountId String?

  channel       ConversationChannel
  instanceId    String?             // nome da instância Evolution que recebeu a mensagem
  status        ConversationStatus  @default(EM_ANALISE)
  leadValue     Decimal?            @db.Decimal(10, 2)
  aiReason      String?
  nextAction    String?
  tone          String?
  preview       String?
  lastMessageAt DateTime?
  lastReadAt    DateTime?
  customerLastReadAt DateTime?
  transferredAt  DateTime?
  transferredBy  String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id])
  agent     Agent?    @relation(fields: [agentId], references: [id])
  attendant User?     @relation("ConversationAttendant", fields: [attendantId], references: [id])
  team      SalesTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  messages         Message[]
  tags             ConversationTagLink[]
  aiAudits         AIAudit[]
  outboundMessages OutboundMessage[]
  quotes           Quote[]
  attachments      MessageAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([companyId, status])
  @@index([companyId, channel])
  @@index([agentId])
  @@index([emailAccountId])
  @@index([teamId])
  @@index([lastMessageAt])
  @@index([transferredAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  authorName     String
  role           MessageRole
  text           String      @db.Text
  isAiGenerated  Boolean     @default(false)
  align          String?     @default("left")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id             String                @id @default(cuid())
  companyId      String
  conversationId String
  messageId      String?
  type           MessageAttachmentType
  fileName       String
  mimeType       String
  size           Int?
  url            String
  storagePath    String?
  source         String                @default("LOCAL")
  externalUrl    String?
  metadata       Json?

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([conversationId])
  @@index([messageId])
  @@index([type])
}

/// Per-company tag reused by conversations and customers
model Tag {
  id        String @id @default(cuid())
  companyId String
  name      String
  color     String @default("#6366f1")

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationTags ConversationTagLink[]
  customerTags     CustomerTagLink[]

  @@unique([companyId, name])
  @@index([companyId])
}

model ConversationTagLink {
  conversationId String
  tagId          String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
}

model CustomerTagLink {
  customerId String
  tagId      String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL — AI AGENTS
// ─────────────────────────────────────────────────────────────────────────────

model Agent {
  id           String      @id @default(cuid())
  companyId    String
  name         String
  iconName     String?
  status       AgentStatus @default(ONLINE)
  description  String?
  instructions String?     @db.Text  // assembled system prompt — consumed by automations
  config       Json?                 // structured studio config (objetivo, tom, formato, restricoes, etc.)
  modelId      String?
  temperatura  Float       @default(0.3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  flowNodes     FlowNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL — KNOWLEDGE BASE
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeArticle {
  id                 String                 @id @default(cuid())
  companyId          String
  parentId           String?
  createdById        String?
  publishedVersionId String?                @unique
  draftVersionId     String?                @unique
  title              String
  category           String
  content            String                 @db.Text
  tags               String?                @db.Text
  channels           String                 @default("[]") @db.Text
  status             KnowledgeArticleStatus @default(RASCUNHO)

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent           KnowledgeArticle?        @relation("KnowledgeArticleTree", fields: [parentId], references: [id])
  children         KnowledgeArticle[]       @relation("KnowledgeArticleTree")
  createdBy        User?                    @relation("KnowledgeArticleAuthor", fields: [createdById], references: [id])
  versions         KnowledgeArticleVersion[] @relation("ArticleVersions")
  publishedVersion KnowledgeArticleVersion? @relation("PublishedKnowledgeVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  draftVersion     KnowledgeArticleVersion? @relation("DraftKnowledgeVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([parentId])
  @@index([createdById])
}

model KnowledgeArticleVersion {
  id          String                 @id @default(cuid())
  articleId   String
  createdById String?
  version     Int
  status      KnowledgeArticleStatus @default(RASCUNHO)
  content     String                 @db.Text
  publishedAt DateTime?

  article   KnowledgeArticle @relation("ArticleVersions", fields: [articleId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("KnowledgeArticleVersionAuthor", fields: [createdById], references: [id])
  publishedByArticles KnowledgeArticle[] @relation("PublishedKnowledgeVersion")
  draftForArticles     KnowledgeArticle[] @relation("DraftKnowledgeVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, version])
  @@index([articleId])
  @@index([createdById])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL — CUSTOMERS
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String  @id @default(cuid())
  companyId String
  ownerId   String?

  name          String
  companyName   String?
  phone         String?
  email         String?
  document      String?
  city          String?
  stage         CustomerStage  @default(QUALIFICACAO)
  status        CustomerStatus @default(EM_ANALISE)
  source        LeadSource?
  segment       String?
  value         Decimal?       @db.Decimal(12, 2)
  lifetimeValue Decimal?       @db.Decimal(12, 2)
  lastContactAt DateTime?

  isVip Boolean @default(false)

  // Denormalised AI snapshot for fast list rendering
  aiScore          Int?
  aiSentiment      Sentiment?
  aiRisk           RiskLevel?
  aiNextBestAction String?

  businessAccountId String?
  businessAccount   BusinessAccount? @relation(fields: [businessAccountId], references: [id], onDelete: SetNull)

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner         User?                 @relation("CustomerOwner", fields: [ownerId], references: [id])
  tags          CustomerTagLink[]
  conversations Conversation[]
  products      CustomerProduct[]
  quotes        Quote[]
  attendants    CustomerAttendant[]
  chatHistory   CustomerChatHistory[]
  aiFindings    CustomerAIFinding[]
  kanbanCards   KanbanCard[]
  segmentLinks  SegmentCustomer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, stage])
  @@index([ownerId])
  @@index([email])
  @@unique([companyId, phone])
  @@unique([companyId, email])
  @@unique([companyId, document])
}

model CustomerProduct {
  id          String        @id @default(cuid())
  customerId  String
  productName String
  status      ProductStatus @default(ATIVO)
  price       Decimal?      @db.Decimal(10, 2)
  description String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CustomerAttendant {
  id          String  @id @default(cuid())
  customerId  String
  userId      String?
  name        String
  role        String
  description String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
}

model CustomerChatHistory {
  id         String              @id @default(cuid())
  customerId String
  channel    ConversationChannel
  occurredAt DateTime
  topic      String?
  sentiment  ChatSentiment       @default(NEUTRO)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, occurredAt])
}

model CustomerAIFinding {
  id         String @id @default(cuid())
  customerId String
  text       String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// OPERATIONAL — PRODUCT CATALOG & QUOTES
// ─────────────────────────────────────────────────────────────────────────────

model ProductCategory {
  id          String            @id @default(cuid())
  companyId   String
  name        String
  description String?
  status      CatalogItemStatus @default(ATIVO)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products CatalogProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, status])
}

model CatalogProduct {
  id          String            @id @default(cuid())
  companyId   String
  categoryId  String?
  name        String
  sku         String?
  description String?
  unit        String            @default("un")
  price       Decimal           @default(0) @db.Decimal(12, 2)
  status      CatalogItemStatus @default(ATIVO)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([companyId, status])
}

model Quote {
  id             String      @id @default(cuid())
  companyId      String
  customerId     String
  conversationId String?
  generatedById  String?
  number         Int
  status         QuoteStatus @default(RASCUNHO)
  validUntil     DateTime
  notes          String?
  freight        Decimal     @default(0) @db.Decimal(12, 2)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
