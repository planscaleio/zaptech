{
  "name": "zapvendas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server": "tsx watch server/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3100",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --url \"postgresql://db_zapvendas:db_zapvendas@localhost:5432/zapvendas?schema=public\"",
    "db:generate": "prisma generate",
    "db:seed:pipelines": "tsx prisma/seed-pipelines.ts",
    "db:seed:emails": "tsx prisma/seed-emails.ts"
  },
